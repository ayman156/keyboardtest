<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#EFEFEF"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- شريط الأدوات العلوي (الحافظة والميزات) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#D1D5DB"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btn_change_lang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="EN / عربي"
            android:textSize="12sp"
            android:backgroundTint="#4B5563"/>

        <Button
            android:id="@+id/btn_normal_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_margin="2dp"
            android:text="لصق عادي"
            android:textSize="12sp"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btn_simulate_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:layout_margin="2dp"
            android:text="محاكاة الكتابة"
            android:textSize="12sp"
            android:backgroundTint="#DC2626"/>
    </LinearLayout>

    <!-- واجهة الحروف الإنجليزية -->
    <LinearLayout
        android:id="@+id/layout_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- الصف الأول EN -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Q" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="E" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="R" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Y" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="U" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="I" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="O" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="P" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف الثاني EN -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="15dp" android:paddingEnd="15dp">
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="A" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="D" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="G" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="H" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="J" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="K" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="L" style="@style/KeyStyle"/>
        </LinearLayout>
    </LinearLayout>

    <!-- واجهة الحروف العربية -->
    <LinearLayout
        android:id="@+id/layout_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- الصف الأول AR -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ض" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ص" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ث" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ق" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ف" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="غ" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ع" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="هـ" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="خ" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ح" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ج" style="@style/KeyStyle"/>
        </LinearLayout>

        <!-- الصف الثاني AR -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ش" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="س" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ي" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ب" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ل" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ا" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ت" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ن" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="م" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ك" style="@style/KeyStyle"/>
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ط" style="@style/KeyStyle"/>
        </LinearLayout>
    </LinearLayout>

    <!-- الأزرار الثابتة السفلية (المسافة، الحذف، الإدخال) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="حذف"
            android:backgroundTint="#9CA3AF"
            style="@style/KeyStyle"/>

        <Button
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:text="Space / مسافة"
            style="@style/KeyStyle"/>

        <Button
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="إدخال"
            android:backgroundTint="#10B981"
            style="@style/KeyStyle"/>
    </LinearLayout>

</LinearLayout>
