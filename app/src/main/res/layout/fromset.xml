<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/textview7"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="إنشاء مجموعة نماذج مضمنة"
			android:textSize="20sp"
			android:textStyle="bold" />
	</LinearLayout>
	<TextView
		android:id="@+id/textview13"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="TextView"
		android:textSize="12sp" />
	<TextView
		android:id="@+id/textview8"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="8dp"
		android:text="النموذج الأب (Parent Model):"
		android:textSize="12sp" />
	<Spinner
		android:id="@+id/parent_model_spinner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="16dp"
		android:spinnerMode="dropdown" />
	<TextView
		android:id="@+id/textview9"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="8dp"
		android:text="النموذج الابن (Child Model):"
		android:textSize="12sp" />
	<Spinner
		android:id="@+id/child_model_spinner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="16dp"
		android:spinnerMode="dropdown" />
	<TextView
		android:id="@+id/textview10"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="8dp"
		android:text="اسم العلاقة (Relationship Name):"
		android:textSize="12sp" />
	<EditText
		android:id="@+id/relationship_name"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="16dp"
		android:textSize="12sp"
		android:hint="مثال: subjects_set" />
	<LinearLayout
		android:id="@+id/linear3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal">
		<EditText
			android:id="@+id/extra_fields"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="1"
			android:textSize="12sp"
			android:layout_weight="1"
			android:inputType="number" />
		<TextView
			android:id="@+id/textview11"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="8dp"
			android:text="عدد النماذج الإضافية الفارغة:"
			android:textSize="12sp" />
	</LinearLayout>
	<TextView
		android:id="@+id/textview12"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="8dp"
		android:text="بادئة النموذج (Form Prefix):"
		android:textSize="12sp" />
	<EditText
		android:id="@+id/prefix"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="formset"
		android:textSize="12sp"
		android:hint="مثال: formset" />
	<LinearLayout
		android:id="@+id/linear2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:orientation="horizontal"
		android:layout_gravity="center_horizontal|center_vertical">
		<CheckBox
			android:id="@+id/can_delete"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="السماح بحذف العناصر المرتبطة"
			android:textSize="12sp"
			android:checked="true"
			android:layout_gravity="center_horizontal|center_vertical" />
	</LinearLayout>
	<Button
		android:id="@+id/save_btn"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#2196F3"
		android:text="حفظ مجموعة النماذج"
		android:textSize="12sp"
		android:textColor="#FFFFFF" />
	<ListView
		android:id="@+id/formsetsListView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:choiceMode="none" />
</LinearLayout>
